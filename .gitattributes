# Pin LF in working copies regardless of OS. Without this, Git for
# Windows' default `core.autocrlf=true` would rewrite LF -> CRLF on
# every checkout, producing the per-file "LF will be replaced by CRLF"
# warnings on every `git add` and breaking shell scripts / systemd
# units / Makefiles / Go tooling that require LF.
* text=auto eol=lf

# Belt-and-suspenders pins for tooling-sensitive file types.
*.go        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
Makefile    text eol=lf
*.service   text eol=lf
go.mod      text eol=lf
go.sum      text eol=lf

# Windows-only scripts keep CRLF — explicit, in case someone adds
# helper .bat/.ps1 files later.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
